{
  "name": "campusloop",
  "version": "1.0.0",
  "description": "CampusLoop — Smart Campus Lost & Found Portal",
  "scripts": {
    "build": "cd client && npm install && npm run build",
    "start": "cd server && npm start",
    "server": "cd server && npm start",
    "client": "cd client && npm start",
    "dev": "start cmd /k \"cd server && npm run dev\" && start cmd /k \"cd client && npm start\"",
    "seed": "cd server && node utils/seed.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "slugify": "^1.6.6",
    "uuid": "^9.0.1"
  }
}
